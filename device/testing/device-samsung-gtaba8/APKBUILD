# Reference: <https://postmarketos.org/devicepkg>
maintainer="Simeon Huang <hzwhuang@gmail.com>"
pkgname=device-samsung-gtaba8
pkgdesc="Samsung Galaxy Tab A8 10.5 (2021)"
pkgver=1
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	firmware-samsung-gtaba8
	linux-samsung-gtaba8
	mesa-dri-gallium
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-kwin"
source="
	deviceinfo
	kernel-cmdline.conf
	postprocess-bootimg.sh
	50-samsung-gtaba8-kwin.conf
	kwin.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir/postprocess-bootimg.sh" \
		"$pkgdir/usr/share/mkinitfs/postprocess-bootimg.sh"
}

kwin() {
	install_if="$pkgname kwin"
	install -Dm644 "$srcdir/50-samsung-gtaba8-kwin.conf" \
		"$subpkgdir/etc/environment.d/50-samsung-gtaba8-kwin.conf"
	install -Dm644 "$srcdir/kwin.sh" \
		"$subpkgdir/etc/profile.d/kwin.sh"
}

