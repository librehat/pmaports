# Reference: <https://postmarketos.org/firmware>
maintainer="Simeon Huang <hzwhuang@gmail.com>"
pkgname=firmware-samsung-gtaba8
pkgver=1
pkgrel=1
pkgdesc="Wireless (UWE5622) and touchscreen (Novatek) firmware for Samsung Galaxy Tab A8 (SM-X200/SM-X205)"
url="https://github.com/librehat/gta8-sm-x200-linux"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !spdx !tracedeps pmb:cross-native"
builddir="$srcdir/$pkgname"
source=""
sha512sums=""

package() {
	local wcn_dir="$builddir"
	if [ -d "$builddir/uwe5622" ]; then
		wcn_dir="$builddir/uwe5622"
	fi

	if [ ! -f "$wcn_dir/wcnmodem.bin" ]; then
		error "Missing $wcn_dir/wcnmodem.bin"
		error "Build with: pmbootstrap build $pkgname --src=/path/to/firmware/uwe5622 --force"
		return 1
	fi

	install -Dm644 "$wcn_dir/wcnmodem.bin" \
		"$pkgdir/usr/lib/firmware/uwe5622/wcnmodem.bin"

	local f
	for f in \
		wifi_board_config.ini \
		bt_configure_pskey.ini \
		bt_configure_pskey_aa.ini \
		bt_configure_rf.ini \
		bt_configure_rf_aa.ini; do
		if [ -f "$wcn_dir/$f" ]; then
			install -Dm644 "$wcn_dir/$f" \
				"$pkgdir/usr/lib/firmware/uwe5622/$f"
		fi
	done

	local ts_found=0
	local ts_dir
	for ts_dir in "$builddir/touchscreen" "$builddir"; do
		for f in "$ts_dir"/nt36523b*.bin; do
			[ -f "$f" ] || continue
			local bname="${f##*/}"
			install -Dm644 "$f" \
				"$pkgdir/usr/lib/firmware/$bname"
			mkdir -p "$pkgdir/usr/share/mkinitfs/files"
			printf '/usr/lib/firmware/%s\n' "$bname" >> \
				"$pkgdir/usr/share/mkinitfs/files/30-initramfs-$pkgname.files"
			ts_found=1
		done
		[ "$ts_found" = 1 ] && break
	done
}
