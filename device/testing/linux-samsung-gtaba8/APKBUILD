# Reference: <https://postmarketos.org/vendorkernel>
maintainer="Simeon Huang <hzwhuang@gmail.com>"
_flavor="samsung-gtaba8"
pkgname=linux-$_flavor
pkgver=7.3.0
pkgrel=0
pkgdesc="Linux mainline v7.3 kernel for Samsung Galaxy Tab A8 10.5 (2021)"
arch="aarch64"
_carch="arm64"
url="https://github.com/librehat/linux"
license="GPL-2.0-only"
options="
	!strip
	!check
	!tracedeps
	pmb:cross-native
"
makedepends="
	bc
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

_commit="8afc29f500af71882b63ab585a00fec56ad72db1"
_config="config-$_flavor.$arch"

builddir="$srcdir/linux-$_commit"
source="
	$pkgname-$_commit.tar.gz::https://github.com/librehat/linux/archive/$_commit.tar.gz
	$_config
	reloc.S
"

prepare() {
	default_prepare
	if [ -d /mnt/pmbootstrap/source-override ]; then
		# pmbootstrap --src uses rsync --exclude-from=.gitignore, which ignores
		# git's '!' negation (!kernel/time/timeconst.bc vs *.bc) and copies
		# host-built glibc helpers from subdirectory .gitignore paths.
		cp -a /mnt/pmbootstrap/source-override/kernel/time/timeconst.bc \
			"$builddir/kernel/time/timeconst.bc"
		rm -f \
			"$builddir/arch/arm64/kernel/pi/relacheck" \
			"$builddir/certs/extract-cert" \
			"$builddir/drivers/tty/vt/conmakehash" \
			"$builddir/drivers/video/logo/pnmtologo" \
			"$builddir/lib/crc/gen_crc32table" \
			"$builddir/lib/crc/gen_crc64table" \
			"$builddir/scripts/asn1_compiler" \
			"$builddir/scripts/basic/fixdep" \
			"$builddir/scripts/dtc/dtc" \
			"$builddir/scripts/dtc/fdtoverlay" \
			"$builddir/scripts/kallsyms" \
			"$builddir/scripts/kconfig/conf" \
			"$builddir/scripts/mod/mk_elfconfig" \
			"$builddir/scripts/mod/modpost" \
			"$builddir/scripts/selinux/mdp/mdp" \
			"$builddir/scripts/sorttable" \
			"$builddir/security/selinux/genheaders" \
			"$builddir/usr/gen_init_cpio" \
			"$builddir/usr/initramfs_data.cpio" \
			"$builddir/usr/initramfs_inc_data"
	fi
	cp "$srcdir/config-$_flavor.$arch" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		olddefconfig
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" \
		Image modules dtbs

	# Prepend 4K 2MB-aligning relocation stub required by SM-X200 LK (0x80080000 -> 0x80200000)
	"${CROSS_COMPILE}as" "$srcdir/reloc.S" -o "$builddir/reloc.o"
	"${CROSS_COMPILE}objcopy" -O binary "$builddir/reloc.o" "$builddir/reloc.bin"
	python3 -c '
import struct, subprocess, sys
bdir, nm = sys.argv[1], sys.argv[2]
stub = bytearray(open(bdir + "/reloc.bin", "rb").read())
stub += b"\0" * (4096 - len(stub))
k = bytearray(open(bdir + "/arch/arm64/boot/Image", "rb").read())
k += b"\0" * ((-len(k)) % 16)
off = {l.split()[2]: int(l.split()[0], 16) for l in
       subprocess.check_output([nm, bdir + "/reloc.o"]).decode().splitlines()}
assert off["payload"] == 4096
ks = struct.unpack("<Q", k[16:24])[0]
struct.pack_into("<Q", stub, off["payload_size"], len(k))
struct.pack_into("<Q", stub, 16, 0x200000 + max(ks, len(k)))
open(bdir + "/arch/arm64/boot/Image.reloc", "wb").write(stub + k)
' "$builddir" "${CROSS_COMPILE}nm"
}

package() {
	mkdir -p "$pkgdir"/boot

	install -Dm644 "$builddir/arch/$_carch/boot/Image.reloc" \
		"$pkgdir/boot/vmlinuz"

	make dtbs_install modules_install \
		ARCH="$_carch" \
		CC="${CC:-gcc}" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir/usr" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	# Wrap board DTB in an unpadded Android DT table (magic 0xd7b7ab1e) for SM-X200 LK v2 boot.img
	python3 -c '
import struct, sys
p = sys.argv[1]
dtb = open(p, "rb").read()
hdr = struct.pack(">8I", 0xd7b7ab1e, 64 + len(dtb), 32, 32, 1, 32, 2048, 0)
ent = struct.pack(">8I", len(dtb), 64, 0, 0, 0, 0, 0, 0)
open(p, "wb").write(hdr + ent + dtb)
' "$pkgdir/boot/dtbs/sprd/ums512-samsung-gtaba8.dtb"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

